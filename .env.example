# ============================================
# StudyMitra - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# --- LLM Configuration ---
LLM_PROVIDER=openai          # openai | groq | ollama
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# --- Embedding Model ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- Reranker ---
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=5

# --- Qdrant Vector Database ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=studymitra_chunks

# --- Chunking ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Retrieval ---
RETRIEVAL_TOP_K=10
HYBRID_ALPHA=0.7             # 1.0 = pure vector, 0.0 = pure keyword

# --- Upload ---
MAX_FILE_SIZE_MB=50

# --- App ---
DEBUG=false
