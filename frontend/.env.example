# ============================================
# StudyMitra Frontend - Environment Configuration
# ============================================

# Target URL for the Vite development proxy (/api/* -> target/api/*)
# Default is http://127.0.0.1:8000
API_PROXY_TARGET=http://127.0.0.1:8000

# Base URL used by the client for API requests
# Default is '/api' (relative, handled by Vite proxy in dev or Nginx in Docker)
# For a separate production API origin, set e.g. https://api.studymitra.local/api
VITE_API_BASE_URL=/api
